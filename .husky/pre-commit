if [[ $SKIP_HOOKS -gt 0 ]]; then
  echo "[PRE-COMMIT] skipping hooks (SKIP_HOOKS=$SKIP_HOOKS)"
  exit 0
fi

echo "[PRE-COMMIT] Checking package-lock.json is registry-only..."
node scripts/check-lockfile-registry-only.mjs || {
  echo "[PRE-COMMIT] package-lock.json has link:/file:/workspace: or local resolved paths. Run 'npm install --no-workspaces' to regenerate. See release-tracking.mdc."
  exit 1
}

echo "[PRE-COMMIT] Run lint-staged"
npx lint-staged || {
  echo "[PRE-COMMIT] lint-staged reported errors it could not auto-fix. Fix them manually and try again."
  exit 1
}

echo "[PRE-COMMIT] Running TypeScript compile..."
npm run compile --no-workspaces || {
  echo "[PRE-COMMIT] Compile failed. Fix the errors above and try again."
  exit 1
}

# Verify the shipped esbuild bundle is OS-portable whenever the bundler or the
# client source that goes into it changes. Skipped for unrelated commits to keep
# them fast (CI runs it on every push/PR regardless). Guards against baking a
# build-machine absolute path into import.meta.url (would break activation on a
# different OS — see scripts/test-bundle.mjs).
if git diff --cached --name-only | grep -Eq '^(scripts/esbuild-client\.mjs|scripts/test-bundle\.mjs|client/src/)'; then
  echo "[PRE-COMMIT] Bundler or client source changed — verifying bundle is OS-portable..."
  npm run test:bundle || {
    echo "[PRE-COMMIT] Bundle integrity check failed. See scripts/test-bundle.mjs."
    exit 1
  }
fi

echo "[PRE-COMMIT] All checks passed."
