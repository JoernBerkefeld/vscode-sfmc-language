{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": ["node"],
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "out",
        "rootDir": "src"
    },
    "include": ["src", "src/test"],
    "exclude": ["node_modules", ".vscode-test"]
}
