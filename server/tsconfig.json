{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "commonjs",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "out",
        "rootDir": "src"
    },
    "include": ["src", "src/test"],
    "exclude": ["node_modules", ".vscode-test"]
}
