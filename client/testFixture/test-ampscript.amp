%%[
/* =============================================================================
   AMPscript Test File for Extension Development
   Use this file to test completions, hover, and diagnostics
   ============================================================================= */

/* -----------------------------------------------------------------------------
   Variable Declarations - test SET keyword and @ variables
   ----------------------------------------------------------------------------- */

/* Completions: type "SET" and verify keyword appears */
SET @firstName = "John"
SET @lastName = "Doe"
SET @email = "john.doe@example.com"
SET @today = Now()
SET @counter = 0

/* -----------------------------------------------------------------------------
   Data Extension Functions - test completions and hover
   ----------------------------------------------------------------------------- */

/* Hover: hover over Lookup to see signature */
SET @value = Lookup("MyDataExtension", "ReturnField", "LookupField", @email)

/* Hover: verify LookupRows shows correct signature */
SET @rows = LookupRows("MyDataExtension", "Status", "Active")

/* Hover: verify LookupOrderedRows shows correct signature */
SET @orderedRows = LookupOrderedRows("MyDataExtension", 10, "CreatedDate DESC", "Status", "Active")

/* Hover: verify Row and Field functions */
SET @rowCount = RowCount(@rows)
IF @rowCount > 0 THEN
    SET @row = Row(@rows, 1)
    SET @fieldValue = Field(@row, "FieldName")
ENDIF

/* Hover: verify InsertData shows correct signature */
SET @insertResult = InsertData("MyDataExtension", "Email", @email, "FirstName", @firstName)

/* Hover: verify UpdateData shows correct signature */
SET @updateResult = UpdateData("MyDataExtension", 1, "Email", @email, "FirstName", "Updated")

/* Hover: verify UpsertData shows correct signature */
SET @upsertResult = UpsertData("MyDataExtension", 1, "Email", @email, "FirstName", @firstName, "LastName", @lastName)

/* Hover: verify DeleteData shows correct signature */
SET @deleteResult = DeleteData("MyDataExtension", "Email", @email)

/* -----------------------------------------------------------------------------
   String Functions - test completions and hover
   ----------------------------------------------------------------------------- */

/* Hover: verify Concat shows correct signature */
SET @fullName = Concat(@firstName, " ", @lastName)

/* Hover: verify Substring shows correct signature */
SET @sub = Substring(@firstName, 1, 3)

/* Hover: verify Length shows correct signature */
SET @len = Length(@firstName)

/* Hover: verify Uppercase/Lowercase shows correct signature */
SET @upper = Uppercase(@firstName)
SET @lower = Lowercase(@lastName)

/* Hover: verify Replace shows correct signature */
SET @replaced = Replace(@fullName, " ", "_")

/* Hover: verify Trim shows correct signature */
SET @trimmed = Trim("  spaces  ")

/* -----------------------------------------------------------------------------
   Date/Time Functions - test completions and hover
   ----------------------------------------------------------------------------- */

/* Hover: verify Now shows correct signature */
SET @currentDate = Now()

/* Hover: verify Format shows correct signature */
SET @formattedDate = Format(@currentDate, "MMMM d, yyyy")
SET @formattedTime = Format(@currentDate, "HH:mm:ss")

/* Hover: verify DateAdd shows correct signature */
SET @futureDate = DateAdd(@currentDate, 7, "D")
SET @pastDate = DateAdd(@currentDate, -1, "M")

/* Hover: verify DateDiff shows correct signature */
SET @daysDiff = DateDiff(@currentDate, @futureDate, "D")

/* Hover: verify DatePart shows correct signature */
SET @year = DatePart(@currentDate, "Y")
SET @month = DatePart(@currentDate, "M")
SET @day = DatePart(@currentDate, "D")

/* -----------------------------------------------------------------------------
   Control Flow - test IF/ELSEIF/ELSE/ENDIF and FOR
   ----------------------------------------------------------------------------- */

/* Completions: type "IF" and verify keyword appears */
IF @counter == 0 THEN
    SET @message = "Counter is zero"
ELSEIF @counter > 0 THEN
    SET @message = "Counter is positive"
ELSE
    SET @message = "Counter is negative"
ENDIF

/* Completions: type "FOR" and verify keyword appears */
FOR @i = 1 TO @rowCount DO
    SET @currentRow = Row(@rows, @i)
    SET @currentEmail = Field(@currentRow, "Email")
NEXT @i

/* -----------------------------------------------------------------------------
   ampscript-data v2.0.0 changes — verify hover/signature/completion
   ----------------------------------------------------------------------------- */

/* New: AttachFile now requires only 2 args (was 4) — signature help should mark
   the last params optional. Calling with 2 args must NOT raise an arity error. */
SET @attach = AttachFile("filename", "displayname")

/* New: HTTPPost2 rebuilt — signature help shows
   url, contentType, contentToPost, exceptionOnError, response, responseRowSet
   (then optional repeating headerName/headerValue pairs).
   Hover example should be the 6-arg form. */
SET @status = HTTPPost2("https://example.com", "application/json", @payload, true, @response, @responseRowSet)

/* New: variadic repeat groups — Concat repeats a single param any number of times;
   signature help should keep accepting more args without an arity error. */
SET @joined = Concat(@firstName, " ", @lastName, " (", @email, ")")

/* New: UpdateData / UpsertData are 1+N variadic (id + repeating column/value pairs).
   Signature help should show the repeating pair group. */
SET @updated = UpdateData("MyDE", 1, "Email", @email)
SET @upserted = UpsertData("MyDE", 1, "Email", @email, "Status", "active")

/* New: inline deprecation — hover over ContentArea / ContentAreaByName should show
   the deprecation note and the recommended replacement (ContentBlockById / ...ByName). */
SET @legacy = ContentArea(12345)
SET @legacyByName = ContentAreaByName("my-content")

/* New: DatePart returns a string — hover return type should read "string".
   Completion of the 2nd arg should offer: year, Y, month, M, monthName, day, D, hour, H, minute, MI */
SET @monthName = DatePart(@currentDate, "monthname")

/* New: union-type validation — GetPublishedSocialContent accepts string|number;
   neither of these should raise a type-mismatch diagnostic. */
SET @social1 = GetPublishedSocialContent("abc123")
SET @social2 = GetPublishedSocialContent(123)

/* New: GetSocialPublishURL — 1st arg socialNetworkCode is a number (no quotes). */
SET @pubUrl = GetSocialPublishURL(1, "https://example.com")

/* New: ContentImageByID requires at least 2 args — calling with 1 should warn (min args). */
SET @img = ContentImageByID(12345, "Alt text")

/* New: BarcodeURL — hover/signature should show clean param names without "bool" prefixes
   (showText, transparentBG instead of boolShowText, boolTransparentBG). */
SET @barcode = BarcodeURL("12345", "qr", 200, 200, "", true, "scan me", 0, false)

]%%

<!-- Inline AMPscript expressions -->
<html>
<body>
    <h1>Hello, %%=v(@firstName)=%%!</h1>

    <!-- Hover: verify inline function calls -->
    <p>Your email is: %%=v(@email)=%%</p>
    <p>Today's date: %%=Format(Now(), "MMMM d, yyyy")=%%</p>
    <p>Full name: %%=Concat(@firstName, " ", @lastName)=%%</p>

    <!-- Inline Lookup -->
    <p>Status: %%=Lookup("MyDE", "Status", "Email", @email)=%%</p>

    <!-- New: MCN compatibility — hover should show "Supported in Marketing Cloud Next (API v67.0+)" -->
    <p>Upper: %%=UpperCase(@firstName)=%%</p>
    <p>Formatted date: %%=FormatDate(Now(), "MM/dd/yyyy")=%%</p>

    <!-- New: MCN unsupported — hover should show "Not supported in Marketing Cloud Next" -->
    <!-- (InsertDE is not in MCN; enable targetPlatform:"next" to see the error diagnostic) -->
    %%[
        /* InsertDE("MyDE", 1, "Email", @email) */
    ]%%
</body>
</html>
/* Sample A: rowset type hover */
%%[
  SET @rows = LookupRows('MyDE', 'Status', 'Active')
  /* Hover @rows above to see: Type: rowset */
]%%

/* Sample B: FOR loop index type hover */
%%[
  FOR @i = 1 TO 5 DO
    /* Hover @i to see: Type: number */
  NEXT @i
]%%

/* Sample C: string literal type hover */
%%[
  SET @name = "John"
  /* Hover @name to see: Type: string */
]%%

/* Sample D: type mismatch warning */
%%[
  SET @name = "Alice"
  SET @count = RowCount(@name)
  /* @name is string but RowCount expects rowset → should show warning */
]%%

/* Sample E: deprecated function warning */
%%[
  /* Replace DeprecatedFunctionName with an actual deprecated AMPscript function */
  SET @r = ContentArea("DE","col","val","col2","val2")
  /* hover WAT to see deprecation warning with replacement */
]%%

/* Sample F: enum completions */
%%[
  SET @diff = DateDiff(NOW(), NOW(), /* <-- place cursor here, trigger completions */ )
]%%

/* Sample G: invalid enum value → warning */
%%[
  SET @diff = DateDiff(NOW(), NOW(), "X")
  /* "X" is not a valid DatePart → should show warning */
]%%

/* Sample H: non-functional-at-runtime → error + struck-through completion.
   GetPortfolioItem and GetPublishedSocialContent resolve at runtime but have no
   known working invocation (their underlying Classic feature is retired), so
   every reached call aborts the page. Both should:
     - show a red squiggle (Error, code ampscript/nonfunctional-function)
     - render struck through in completions (like a deprecated function)
   They still appear in completions and hover — they exist in the language. */
%%[
  SET @portfolio = GetPortfolioItem("my-portfolio-key")
  SET @socialContent = GetPublishedSocialContent("socialContentId")
]%%
