{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2024",
        "lib": ["ES2024"],
        "outDir": "out",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
        "types": ["node", "mocha", "vscode"]
    },
    "include": ["src"],
    "exclude": ["node_modules", ".vscode-test"]
}
